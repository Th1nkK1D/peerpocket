{
	"name": "peerpocket",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun run --filter=\"@peerpocket/*\" dev",
		"build": "bun run --filter=\"@peerpocket/*\" build",
		"check": "bun run --filter=\"@peerpocket/*\" --elide-lines=0 check",
		"lint": "bun run biome check --write",
		"test": "bun scripts/free-test-ports.ts && playwright test",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true --colors=off"
	},
	"workspaces": [
		"app",
		"server",
		"libs"
	],
	"devDependencies": {
		"@biomejs/biome": "2.0.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@playwright/test": "^1.55.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2"
	}
}
